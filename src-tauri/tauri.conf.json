{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Shuvi 2",
  "version": "0.1.0",
  "identifier": "ai.shuvi.studio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Shuvi 2 | Creative Studio",
        "width": 1440,
        "height": 900,
        "minWidth": 1050,
        "minHeight": 680
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}
